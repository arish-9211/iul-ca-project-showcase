{
  "name": "iul-ca-project-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate-data.mjs",
    "import:csv": "node scripts/import-csv.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run validate:data && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.4.0",
    "vite": "8.3.4"
  }
}
